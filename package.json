{
  "name": "reviewphin",
  "version": "1.12.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "cli": "tsx src/cli.ts",
    "docs:build": "astro build --root docs",
    "docs:build:container": "pnpm docs:build && node scripts/publish-docs-container.mjs",
    "docs:dev": "astro dev --root docs",
    "dev": "tsx watch src/index.ts",
    "lint:fix": "eslint . --fix",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@github/copilot-sdk": "^1.0.34",
    "fastify": "^5.12.8",
    "glob": "^14.0.6",
    "marked": "^18.2.0",
    "marked-terminal": "^8.0.0",
    "octokit": "^5.0.5",
    "pino": "^10.4.0",
    "sharp": "0.35.5",
    "tar": "^7.5.23",
    "ulidx": "^2.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.43.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "astro": "^7.4.12",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "@flotiq/flotiq-api-sdk": "1.1.2"
  }
}
