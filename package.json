{
  "name": "reviewphin",
  "version": "1.12.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "cli": "tsx src/cli.ts",
    "docs:build": "astro build --root docs",
    "docs:build:container": "pnpm docs:build && node scripts/publish-docs-container.mjs",
    "docs:dev": "astro dev --root docs",
    "dev": "tsx watch src/index.ts",
    "lint:fix": "eslint . --fix",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@github/copilot-sdk": "^1.0.14",
    "fastify": "^5.12.5",
    "glob": "^13.0.6",
    "marked": "^18.0.13",
    "marked-terminal": "^7.3.0",
    "octokit": "^5.0.5",
    "pino": "^10.3.1",
    "sharp": "0.35.4",
    "tar": "^7.5.22",
    "ulidx": "^2.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "astro": "^7.3.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@flotiq/flotiq-api-sdk": "1.1.2"
  }
}
